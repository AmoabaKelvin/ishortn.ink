{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ishortn",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ishortn",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "LINK_CACHE_KV",
      "id": "7423a0ff959e4392b68ad837c0b3ddfe",
    },
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "d4fec53d915842eeb5ce671632ff7a95",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ac816bc62707444ab259acdc494f14dc",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "CLICK_QUEUE",
        "queue": "ishortn-clicks",
      },
    ],
    "consumers": [
      {
        "queue": "ishortn-clicks",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "ishortn-clicks-dlq",
      },
    ],
  },
  // Plain, non-secret config. Secrets stay in `wrangler secret put`; a name can't be both.
  "vars": {
    // Lifecycle email (weekly summary, upgrade nudge) sender, on its own sending subdomain.
    "EMAIL_FROM_LIFECYCLE": "iShortn <hello@updates.ishortn.ink>",
    // Monitored inbox that replies to every product email go to.
    "EMAIL_REPLY_TO": "kelvin@mail.ishortn.ink",
    // Browser extension redirect URIs allowed by /extension/connect, comma-separated. Matched
    // exactly, trailing slash included. Chrome Web Store build:
    "EXTENSION_REDIRECT_URIS": "https://opkikfbhepmnlnblmjnfjgjeonadekdj.chromiumapp.org/",
  },
  "triggers": {
    "crons": [
      "0 9 * * *",
      "0 0 * * *",
      "0 2 * * SUN",
      "0 4 * * *",
      "0 5 * * *",
      "25 * * * *",
      "30 */6 * * *",
      "5,20,35,50 * * * *",
      "10 * * * *",
      "40 * * * *",
      "0 9-17 * * MON",
    ],
  },
  // The phishing rescan streams ~1.2M feed lines in one invocation; this is a ceiling, not a cost.
  "limits": {
    "cpu_ms": 300000,
  },
  // Wrangler uploads source maps unless this is false, and the bundled worker's map is over
  // Cloudflare's 60 MiB upload limit (scripts/ci/check-source-maps.ts guards it).
  "upload_source_maps": false,
  "observability": {
    "enabled": true,
  },
}
