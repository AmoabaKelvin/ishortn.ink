{
  "name": "ishortn",
  "version": "1.0.0",
  "private": true,
  "description": "URL shortening and link management platform",
  "scripts": {
    "setup": "bun scripts/dev/setup.ts",
    "dev": "next dev",
    "d": "bun run setup && bun run dev",
    "build": "next build",
    "start": "next start",
    "preview": "bun scripts/dev/preview.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "stack:down": "docker compose --profile storage down",
    "stack:reset": "docker compose --profile storage down -v",
    "db:push": "dotenv drizzle-kit push",
    "db:generate": "dotenv drizzle-kit generate",
    "db:migrate": "dotenv tsx src/server/db/migrate.ts",
    "db:baseline": "bun scripts/migrations/baseline.ts",
    "db:production:migrate": "dotenv -e .env.prod tsx src/server/db/migrate.ts",
    "db:studio": "dotenv drizzle-kit studio",
    "seed": "bun scripts/dev/seed.ts",
    "webhook": "bun scripts/dev/webhook.ts",
    "cron": "bun scripts/dev/cron.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "email:dev": "email dev --dir src/emails --port 3001",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check:source-maps": "bun scripts/ci/check-source-maps.ts"
  },
