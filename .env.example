# `bun run setup` copies this to .env and fills the generated secrets.
# New variables must also be declared in src/env.mjs.

# ─── Required ─────────────────────────────────────────────────────────────────

# Matches the `db` service in compose.yaml
DATABASE_URL='mysql://ishortn:ishortn@127.0.0.1:3306/ishortn'

NEXT_PUBLIC_APP_URL='http://localhost:3000'

# https://dashboard.clerk.com -> API keys. Dev instances accept
# name+clerk_test@example.com with the code 424242.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='pk_test_'
CLERK_SECRET_KEY='sk_test_'
NEXT_PUBLIC_CLERK_SIGN_IN_URL='/auth/sign-in'
NEXT_PUBLIC_CLERK_SIGN_UP_URL='/auth/sign-up'

# ─── Generated by `bun run setup` (or `openssl rand -hex 32`) ─────────────────

# Visitor-IP HMAC key (>= 16 chars); rotating it resets unique-visit counters
IP_HASH_SECRET=''
# Verified-click token key (>= 32 chars); unset disables the feature
VERIFIED_CLICKS_SECRET=''
# Bearer for /api/cron/* and /api/queue/clicks; `bun run cron` uses it
CRON_SECRET=''
# Clerk webhook signing secret. `bun run webhook clerk` signs with it; for real
# deliveries through a tunnel use the secret from Clerk -> Webhooks.
WEBHOOK_SECRET=''

# ─── Optional: local stack ────────────────────────────────────────────────────

# Host ports published by compose.yaml (update DATABASE_URL / R2_ENDPOINT too)
# DB_PORT=3306
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ─── Optional: image uploads (QR logos, bio avatars, OG images) ───────────────

# Production: Cloudflare R2 (dashboard -> R2 -> Manage R2 API Tokens).
# Local: `docker compose --profile storage up -d` runs MinIO (console on :9001,
# login ishortn / ishortn-secret); uncomment this block to use it.
# R2_ENDPOINT='http://127.0.0.1:9000'
# R2_ACCOUNT_ID='local'
# R2_ACCESS_KEY_ID='ishortn'
# R2_SECRET_ACCESS_KEY='ishortn-secret'
# R2_BUCKET_NAME='ishortn-images'
# R2_PUBLIC_URL='http://127.0.0.1:9000/ishortn-images'

# ─── Optional: billing (Lemon Squeezy, use a test-mode store) ─────────────────

# LEMONSQUEEZY_API_KEY=''
# LEMONSQUEEZY_STORE_ID=''
# Any value works for `bun run webhook lemonsqueezy` replays
# LEMONSQUEEZY_WEBHOOK_SECRET=''

# ─── Optional: transactional email (Resend) ───────────────────────────────────

# Unset: sends are skipped and logged. Templates: `bun run email:dev`
# RESEND_API_KEY='re_'

# ─── Optional: custom domains (Cloudflare for SaaS) ───────────────────────────

# Token needs "SSL and Certificates: Edit" on the SaaS zone
# CLOUDFLARE_API_TOKEN=''
# CLOUDFLARE_SAAS_ZONE_ID=''
# CUSTOM_DOMAIN_CNAME_TARGET='cname.ishortn.ink'
# Shown in the domain migration notice; unset says "in the coming weeks"
# NEXT_PUBLIC_DOMAIN_MIGRATION_DEADLINE='2026-09-30'

# ─── Optional: everything else ────────────────────────────────────────────────

# AI alias suggestions and phishing classification
# OPENAI_API_KEY='sk-'
# Google Safe Browsing / Web Risk (fail-open when unset)
# GOOGLE_SAFE_BROWSING_API_KEY=''
# NEXT_PUBLIC_POSTHOG_KEY='phc_'
# NEXT_PUBLIC_POSTHOG_HOST='https://us.i.posthog.com'
# UMAMI_TRACKING_ID=''
# UMAMI_URL=''
# Feedback and downgrade notifications
# DISCORD_WEBHOOK_URL=''
# pino level; default debug in dev, info in prod
# LOG_LEVEL='debug'
